#!/usr/bin/env bash
# 전역 훅 디스패처.
#
# `git config --global core.hooksPath ~/.git-hooks` 로 걸면 git 은 저장소별
# .git/hooks/ 를 통째로 무시하고 그 디렉토리만 본다. 그래서 이 스크립트가
# 두 곳을 대신 불러 준다:
#
#   1) <저장소>/.githooks/<이름>   커밋으로 전파되는 저장소 규약
#   2) <gitdir>/hooks/<이름>       husky 등이 설치한 로컬 훅
#
# 이렇게 해야 전역 설정이 기존 훅을 죽이지 않는다. 하나라도 0 이 아닌 코드로
# 끝나면 그 코드로 끝낸다.
#
# 이 디스패처를 두는 이유는 core.hooksPath 가 커밋으로 전파되지 않기
# 때문이다. 저장소마다 켜는 대신 기계당 한 번만 켜면, 클론 직후 한 줄을
# 잊어서 훅이 조용히 꺼지는 일이 없어진다.

# 어느 훅으로 불렸는지는 보통 argv[0] 에서 온다. 다만 셔뱅 스크립트를
# exec 로 넘길 때는 커널이 인터프리터를 다시 실행하며 스크립트 경로를
# 넘기므로 argv[0] 이 사라진다 — exec -a 로 정해도 소용없다. 그래서
# 부르는 쪽이 이름을 환경변수로 실어 보낼 수 있게 열어 둔다.
name=${GIT_HOOK_NAME:-${0##*/}}
# 심볼릭 링크가 아니라 본체를 직접 부른 경우
[ "$name" = "dispatch" ] && exit 0

gitdir=$(git rev-parse --git-dir 2>/dev/null) || exit 0
case "$gitdir" in
  /*) ;;
  *) gitdir="$PWD/$gitdir" ;;
esac
# bare 저장소에는 워킹트리가 없어 --show-toplevel 이 실패한다. 그래도
# $gitdir/hooks/ 는 불러야 하므로 root 만 비우고 계속 간다 — 서버측 훅이
# 사는 곳이 바로 bare 저장소다.
root=$(git rev-parse --show-toplevel 2>/dev/null) || root=""

# stdin 을 쓰는 훅은 한 번만 읽어 두고 각 자식에게 다시 먹인다.
#
# $(...) 는 끝의 개행을 전부 지운다. git 이 주는 pre-push 페이로드는 줄마다
# 개행으로 끝나므로, 그대로 다시 먹이면 마지막 줄에 개행이 없어져 자식 훅의
# `while read` 가 그 줄을 버린다. ref 가 하나뿐이면 유일한 줄이 사라져 훅이
# 아무것도 못 읽고 조용히 통과시킨다. 표식을 붙였다 떼어 원본 바이트를 지킨다.
case "$name" in
  pre-push|pre-receive|post-receive|reference-transaction|push-to-checkout|post-rewrite)
    payload=$(cat; printf x)
    payload=${payload%x}
    use_stdin=1 ;;
  *)
    use_stdin=0 ;;
esac

run() {
  local h=$1
  shift
  [ -x "$h" ] || return 0
  if [ "$use_stdin" = 1 ]; then
    printf '%s' "$payload" | "$h" "$@"
  else
    "$h" "$@"
  fi
}

# 부르는 순서는 넓은 것에서 좁은 것으로다 — 기계 전체 규약, 저장소 규약,
# 그 클론에만 있는 훅. 앞의 것이 0 이 아닌 코드로 끝나면 거기서 멈춘다.
for h in "$HOME/.git-hooks/user/$name" ${root:+"$root/.githooks/$name"} "$gitdir/hooks/$name"; do
  run "$h" "$@" || exit $?
done
exit 0
