#!/usr/bin/env bash
# scoped-commits: 커밋 메시지가 규약의 정적 규칙을 지키는지 검사한다.
#
# git 수준 훅이라 커밋을 만드는 모든 것에 걸린다 — Claude Code, Cursor,
# Codex, Aider, 사람, CI. 에이전트별 조기 차단 층은 두지 않는다. 도구마다
# 따로 배선해야 하는 데다, 강제는 어차피 이 파일이 전부 맡기 때문이다.
#
# 이 파일의 존재가 곧 옵인이다. 저장소에는 두기만 하면 된다:
#
#     mkdir -p .githooks
#     cp <스킬 디렉토리>/githooks/commit-msg .githooks/commit-msg
#     chmod +x .githooks/commit-msg
#
# 훅을 부르는 배선은 기계 쪽 일이다. core.hooksPath 가 커밋으로 전파되지
# 않기 때문이다(git 보안 정책). 전역 디스패처(install-dispatch.sh)를 깔면
# 기계당 한 번으로 끝나고, 저장소마다 켜려면 클론마다
# git config core.hooksPath .githooks 를 걸어야 한다.

TYPES='feat|fix|docs|chore|refactor|style|test|build|ci|perf|revert'

title=$(sed -n '1p' "$1")

# 빈 제목이나 주석만 있는 경우는 git 이 알아서 거부한다.
[[ -z ${title// /} || $title == \#* ]] && exit 0

# 머지·리버트·픽스업은 형식을 git 이 만든 것이므로 건드리지 않는다.
[[ $title == Merge\ * || $title == Revert\ * || $title == fixup!\ * || $title == squash!\ * ]] && exit 0

fail() {
  {
    echo
    echo "커밋이 거부되었습니다: $title"
    echo
    echo "$1"
    echo
    echo "이 저장소는 scope 중심 커밋을 씁니다."
    echo "  제목:  <scope>: <설명>"
    echo "  scope: 그 코드가 하는 일의 이름. 소문자 kebab-case."
    echo "         파일명·디렉토리명을 그대로 쓰지 않습니다."
    echo "  예시:  denial-log: 거부를 규칙과 값으로 가른다"
    echo
    echo "규칙은 AGENTS.md 를 보십시오."
  } >&2
  exit 1
}

# 폭 0인 코드포인트인가. 결합 문자와 제로폭·서식 문자가 여기 든다.
# 이것들은 칼럼을 먹지 않고, 제목 끝에 붙어도 눈에 보이는 마지막 글자를
# 바꾸지 않는다 — 그래서 폭 계산과 종결 판정 양쪽에서 건너뛴다.
is_zero_width() {
  local cp=$1
  [ "$cp" -ge 768 ] && [ "$cp" -le 879 ] && return 0        # 0300-036F 결합 발음기호
  [ "$cp" -ge 6832 ] && [ "$cp" -le 6911 ] && return 0      # 1AB0-1AFF 결합 확장
  [ "$cp" -ge 8203 ] && [ "$cp" -le 8207 ] && return 0      # 200B-200F 제로폭·방향 표시
  [ "$cp" -ge 8288 ] && [ "$cp" -le 8303 ] && return 0      # 2060-206F 단어 결합자·서식
  [ "$cp" -ge 8400 ] && [ "$cp" -le 8447 ] && return 0      # 20D0-20FF 기호용 결합 문자
  [ "$cp" -ge 65024 ] && [ "$cp" -le 65039 ] && return 0    # FE00-FE0F 변이 선택자
  [ "$cp" -ge 65056 ] && [ "$cp" -le 65071 ] && return 0    # FE20-FE2F 결합 반문자
  [ "$cp" -eq 65279 ] && return 0                           # FEFF 제로폭 비분리 공백
  return 1
}

# 코드포인트가 동아시아 W/F(표시 폭 2) 구간이면 0 을 돌려준다.
# 구간마다 줄을 갈라 명시적으로 검사한다 — && || 를 한 줄에 이어 붙이면
# 좌결합 평가가 상한이 단조증가일 때만 우연히 맞는 식이 된다.
is_wide() {
  local cp=$1
  [ "$cp" -ge 4352 ] && [ "$cp" -le 4447 ] && return 0      # 1100-115F 한글 자모
  [ "$cp" -ge 11904 ] && [ "$cp" -le 42191 ] &&
    [ "$cp" -ne 12351 ] && return 0                          # 2E80-A4CF CJK (303F 제외)
  [ "$cp" -ge 44032 ] && [ "$cp" -le 55203 ] && return 0    # AC00-D7A3 한글 음절
  [ "$cp" -ge 63744 ] && [ "$cp" -le 64255 ] && return 0    # F900-FAFF CJK 호환 한자
  [ "$cp" -ge 65040 ] && [ "$cp" -le 65049 ] && return 0    # FE10-FE19 세로쓰기 부호
  [ "$cp" -ge 65072 ] && [ "$cp" -le 65135 ] && return 0    # FE30-FE6F CJK 호환 부호
  [ "$cp" -ge 65280 ] && [ "$cp" -le 65376 ] && return 0    # FF00-FF60 전각
  [ "$cp" -ge 65504 ] && [ "$cp" -le 65510 ] && return 0    # FFE0-FFE6 전각 기호
  [ "$cp" -ge 127744 ] && [ "$cp" -le 129791 ] && return 0  # 1F300-1FAFF 이모지
  [ "$cp" -ge 131072 ] && [ "$cp" -le 262141 ] && return 0  # 20000-3FFFD CJK 확장
  return 1
}

# 문자열을 한 번 훑어 "<폭> <눈에 보이는 마지막 글자> <마지막 한글 음절>" 을
# 출력한다. 값이 셋인 것은 세 판정이 서로 다른 것을 봐야 하기 때문이다 —
# 폭은 칼럼을, 마침표는 눈에 보이는 마지막 글자를, 종결은 마지막 한글 음절을
# 본다. 각각 다른 우회를 막는다: 제로폭 문자를 뒤에 붙이면 마침표 판정이
# 비껴가고, 아무 문자나 붙이면 종결 판정이 비껴간다. 한글이 하나도 없으면
# 셋째 값이 0 이고 종결 검사는 건너뛴다.
#
# 서브셸에서 LC_ALL=C 로 돌므로 호출 환경의 로케일과 무관하게 바이트 단위로
# 읽는다 — bash 3.2/5.3, C/UTF-8 로케일에서 같은 값이 나오는 것을 실측했다.
measure() (
  LC_ALL=C
  s=$1 i=0 w=0 last=0 lasthan=0
  n=${#s}
  while [ "$i" -lt "$n" ]; do
    printf -v b '%d' "'${s:i:1}"
    [ "$b" -lt 0 ] && b=$((b + 256))
    if [ "$b" -lt 128 ]; then cp=$b; len=1
    elif [ "$b" -lt 192 ]; then cp=$b; len=1    # 깨진 연속 바이트는 폭 1로 센다
    elif [ "$b" -lt 224 ]; then cp=$((b & 31)); len=2
    elif [ "$b" -lt 240 ]; then cp=$((b & 15)); len=3
    else cp=$((b & 7)); len=4
    fi
    j=1
    while [ "$j" -lt "$len" ]; do
      printf -v b '%d' "'${s:i+j:1}"
      [ "$b" -lt 0 ] && b=$((b + 256))
      cp=$(( (cp << 6) | (b & 63) ))
      j=$((j + 1))
    done
    # 폭 0인 글자는 칼럼도 안 먹고 last 도 갱신하지 않는다. last 는 "눈에
    # 보이는 마지막 글자"여야 한다 — 제로폭 문자를 하나 붙이는 것만으로
    # 마침표 판정이 건너뛰어지면 규칙이 아니라 장식이 된다. 한글 음절은
    # 폭 0인 구간에 없으므로 같은 가드 안에서 함께 기억해도 된다.
    if ! is_zero_width "$cp"; then
      if is_wide "$cp"; then w=$((w + 2)); else w=$((w + 1)); fi
      last=$cp
      [ "$cp" -ge 44032 ] && [ "$cp" -le 55203 ] && lasthan=$cp
    fi
    i=$((i + len))
  done
  echo "$w $last $lasthan"
)

if [[ $title =~ ^($TYPES)(\([^\)]*\))?: ]]; then
  fail "type 접두어($TYPES)를 쓰지 않습니다. 로그를 읽는 사람이 알고 싶은 것은 변경의 종류가 아니라 어느 영역을 건드렸는가입니다."
fi

if [[ $title =~ ^([a-zA-Z0-9][^:[:space:]]*):\ +[^[:space:]] ]]; then
  scope=${BASH_REMATCH[1]}
  if [[ ! $scope =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
    fail "scope '$scope' 가 소문자 kebab-case 가 아닙니다. 소문자·숫자·하이픈만 씁니다."
  fi

  # scope 가 이 커밋이 바꾸는 파일·디렉토리 이름이면 거부한다. 그 이름은
  # 그 파일의 모든 커밋에 똑같이 붙어 아무것도 구별하지 못한다. 스테이징
  # 목록은 commit-msg 시점에도 커밋에 담길 내용과 일치한다 — 부분 커밋에는
  # git 이 임시 인덱스를 물려주므로, 스테이징만 되고 이 커밋에 안 담기는
  # 파일은 잡히지 않는다. git 을 못 부르거나 실패하면 이 검사만 건너뛴다.
  # 잘못 막는 것이 못 잡는 것보다 비싸다.
  #
  # 메시지만 고치는 --amend 는 스테이징이 비어 이 검사를 지나간다. 하필
  # 거부당한 제목을 고치는 방법이 --amend 라 우회 경로로 노출된다. 그래도
  # 막지 않는 것은, 비어 있을 때 HEAD 의 파일 목록으로 대신하면 --allow-empty
  # 커밋을 엉뚱하게 거부하기 때문이다. 둘은 인덱스가 HEAD 와 같다는 점에서
  # 구별되지 않고, git 이 amend 라고 알려 주는 환경변수도 없다(실측).
  staged=$(git diff --cached --name-only 2>/dev/null)
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    lower=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
    rest=$lower
    while :; do
      seg=${rest%%/*}
      if [ "$seg" = "$scope" ] || [ "${seg#.}" = "$scope" ]; then
        fail "scope '$scope' 는 이 커밋이 바꾸는 경로($path)의 이름입니다. 파일명이 아니라 그 변경이 하는 일의 이름을 쓰십시오."
      fi
      if [ "$rest" = "$seg" ]; then
        base=${seg#.}
        if [ -n "${base%.*}" ] && [ "${base%.*}" = "$scope" ]; then
          fail "scope '$scope' 는 이 커밋이 바꾸는 파일($path)의 이름입니다. 파일명이 아니라 그 변경이 하는 일의 이름을 쓰십시오."
        fi
        break
      fi
      rest=${rest#*/}
    done
  done <<EOF
$staged
EOF
else
  fail "제목이 '<scope>: <설명>' 형태가 아닙니다."
fi

# 제목 폭은 문자 수가 아니라 표시 폭으로 센다. messages.md 가 36자의 근거를
# "한글 한 자가 2칼럼이라 72칼럼"으로 적었으므로 판정도 칼럼이다. 순한글
# 제목이면 36자와 정확히 같고, 영문·혼합에서만 덜 빡빡해진다.
read -r width last lasthan <<< "$(measure "$title")"

if [ "$width" -gt 72 ]; then
  fail "제목이 ${width}칼럼입니다. 72칼럼(순한글 36자)을 넘을 수 없습니다."
fi

# 한글이 든 제목은 '다' 로 끝나야 한다. 판정은 마지막 문자가 아니라 마지막
# 한글 음절로 한다 — 마지막 문자만 보면 "제목 고침!" 처럼 뒤에 한 글자만
# 붙여 검사를 피할 수 있었다. 한글이 하나도 없는 제목은 건너뛴다. '~다' 는
# 한국어 문법이라 무조건 걸면 이 배포본을 영문 저장소에서 못 쓴다.
if [ "$lasthan" -ne 0 ] && [ "$lasthan" -ne 45796 ]; then
  fail "제목에 한글이 있으면 '~다' 로 끝나야 합니다. 뒤에 괄호나 부호가 붙어도 마지막 한글이 '다' 여야 합니다."
fi

# 마침표 판정도 눈에 보이는 마지막 글자로 한다. 전각 마침표와 온점은
# ASCII 마침표와 같은 자리에 쓰이므로 같이 막는다 — 한글 제목에서 자판을
# 바꾸지 않고 찍으면 나오는 것이 전각 쪽이다.
#   002E .  3002 。  FF0E ．  FF61 ｡  2026 …
case $last in
  46|12290|65294|65377|8230)
    fail "제목에 마침표를 붙이지 않습니다." ;;
esac

# 본문이 있어야 한다: 제목 다음에 빈 줄, 그 뒤에 비어 있지 않은 줄.
# 존재만 본다 — 길이를 재면 "충분한가"라는 판정이 들어와 정적이 아니게
# 된다. 주석과 scissors 이후(git commit -v 의 diff)는 본문으로 세지 않는다.
lineno=0 body_ok=0
while IFS= read -r line || [ -n "$line" ]; do
  [[ $line == \#*' >8 '* ]] && break
  [[ $line == \#* ]] && continue
  lineno=$((lineno + 1))
  [ "$lineno" -eq 1 ] && continue
  if [ "$lineno" -eq 2 ]; then
    if [[ $line == *[![:space:]]* ]]; then
      fail "제목과 본문 사이에 빈 줄이 있어야 합니다."
    fi
    continue
  fi
  if [[ $line == *[![:space:]]* ]]; then
    body_ok=1
    break
  fi
done < "$1"

if [ "$body_ok" -ne 1 ]; then
  fail "본문이 없습니다. 왜 했는지, 고려했다가 하지 않은 것, 확인하지 못한 것을 산문으로 적으십시오."
fi

exit 0
