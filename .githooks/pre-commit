#!/usr/bin/env bash
# scoped-commits: 저장소가 유지해야 하는 불변을 커밋 직전에 검사한다.
#
# commit-msg 훅은 이 저장소에 두 벌 있다. .githooks/ 의 것은 옵인 신호이자
# 실제로 도는 것이고, 스킬 디렉토리의 것은 다른 저장소로 복사해 갈 배포본이다.
# 둘 다 있어야 하는 구조라 중복을 없앨 수 없는데, 한쪽만 고치면 스킬을 깐
# 사람과 이 저장소가 서로 다른 규칙을 쓰게 되고 아무도 그것을 알아채지 못한다.
#
# 워킹트리가 아니라 인덱스를 본다. 커밋에 실제로 담길 내용이 기준이다.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

fail() {
  {
    echo
    echo "커밋이 거부되었습니다: $1"
    echo
    shift
    for line in "$@"; do echo "$line"; done
  } >&2
  exit 1
}

a=.githooks/commit-msg
b=skills/scoped-commits/githooks/commit-msg

if git cat-file -e ":$a" 2>/dev/null && git cat-file -e ":$b" 2>/dev/null; then
  if ! diff -q <(git show ":$a") <(git show ":$b") >/dev/null 2>&1; then
    fail "commit-msg 두 벌이 어긋났습니다." \
         "  $a" \
         "  $b" \
         "" \
         "한쪽만 고쳤다면 다른 쪽에도 같이 반영하고 함께 스테이징하십시오." \
         "" \
         "차이:" \
         "$(diff <(git show ":$a") <(git show ":$b") | sed 's/^/    /')"
  fi
fi

# type 접두어 목록은 훅이 거부에 쓰고, messages.md 의 과거 scope 조회 스니펫이
# 같은 목록으로 걸러 낸다. 둘 다 실행되는 코드라 어긋나면 조회 결과에 type 이
# 섞여 들어오고, 그것이 다음 커밋의 scope 후보가 된다.
c=skills/scoped-commits/messages.md

if git cat-file -e ":$a" 2>/dev/null && git cat-file -e ":$c" 2>/dev/null; then
  hook_types=$(git show ":$a" | sed -n "s/^TYPES='\(.*\)'.*/\1/p")
  doc_types=$(git show ":$c" | grep -F 'grep -vE' | sed -e "s/.*'^(//" -e "s/)\\$'.*//")

  # 한쪽이 비면 형식이 바뀐 것이다. 지킬 약속이 없으므로 검사하지 않는다.
  if [ -n "$hook_types" ] && [ -n "$doc_types" ] && [ "$hook_types" != "$doc_types" ]; then
    fail "type 목록이 어긋났습니다." \
         "  $a" \
         "    $hook_types" \
         "  $c" \
         "    $doc_types" \
         "" \
         "훅이 거부하는 목록과 문서가 걸러 내는 목록은 같아야 합니다."
  fi
fi

# 제목 폭 상수는 두 자리에 산다 — 훅이 거부에 쓰고, messages.md 가 규칙
# 원문으로 적는다. 실행되는 것은 훅뿐이라 어긋나도 아무도 실패하지 않고,
# 원문이 규칙인 척하는 상태만 남는다. 실제로 그렇게 갈렸던 적이 있어 이
# 검사를 넣었다.
#
# 예전에는 AGENTS.md 의 요약까지 세 자리였다. 그 요약을 지우면서 두 자리가
# 됐다 — 규칙 세부는 커밋을 만들 때만 필요하고 그때는 스킬이 주므로, 매
# 세션 컨텍스트에 실리는 파일이 사본을 들고 있을 이유가 없다.

if git cat-file -e ":$a" 2>/dev/null && git cat-file -e ":$c" 2>/dev/null; then
  hook_w=$(git show ":$a" | sed -n 's/^if \[ "$width" -gt \([0-9]*\) \].*/\1/p')
  msg_w=$(git show ":$c" | sed -n 's/.*\*\*\([0-9]*\)칼럼 이내\.\*\*.*/\1/p')

  # 한쪽이 비면 문면이 바뀐 것이다. 지킬 약속이 없으므로 검사하지 않는다.
  if [ -n "$hook_w" ] && [ -n "$msg_w" ] && [ "$hook_w" != "$msg_w" ]; then
    fail "제목 폭 값이 어긋났습니다." \
         "  $a" \
         "    $hook_w 칼럼" \
         "  $c" \
         "    $msg_w 칼럼" \
         "" \
         "훅이 거부하는 값과 원문이 적는 값은 같아야 합니다."
  fi
fi

exit 0
